ENVIRONMENT=development
APP_HOST=127.0.0.1
PORT=8003
APP_TITLE=SCMXPertLite
APP_DESCRIPTION=Backend services for SCMXPertLite.
APP_VERSION=0.1.0
APP_RELOAD=false
APP_RELOAD_DELAY=0.25
APP_RELOAD_DIRS=backend,tests
APP_RELOAD_INCLUDES=*.py,*.env
APP_RELOAD_EXCLUDES=.git,.venv,venv,__pycache__,.pytest_cache,logs,frontend,pytest-cache-files-*,*.pyc
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=scmxpertlite
USERS_COLLECTION_NAME=users
AUTH_EVENTS_COLLECTION_NAME=auth_events
DEVICES_COLLECTION_NAME=devices
SHIPMENTS_COLLECTION_NAME=shipments
SHIPMENT_TRACKING_PREFIX=SCM-

JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
OAUTH_TOKEN_URL=/api/auth/token
BCRYPT_ROUNDS=12

DEFAULT_ADMIN_UID=default-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
ADMIN_USERNAME=scm_admin
ADMIN_PHONE_NUMBER=9999999999
