ENVIRONMENT=development
APP_HOST=127.0.0.1
PORT=8001
APP_TITLE=SCMXPertLite
APP_DESCRIPTION=Backend services for SCMXPertLite.
APP_VERSION=0.1.0
APP_RELOAD=true
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
FRONTEND_ORIGINS=http://127.0.0.1:8001

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=scmxpertlite
USERS_COLLECTION_NAME=users
DEVICES_COLLECTION_NAME=devices
SHIPMENTS_COLLECTION_NAME=shipments

JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123
ADMIN_USERNAME=scm_admin
ADMIN_PHONE_NUMBER=9999999999
